algoritmo "ContadorAte10"
var
   Valor, Salto, Cont: inteiro
inicio
      Cont <- 0
      Escreva("Quer contar até quanto? ")
      Leia (Valor)
      Escreva("Qual será o valor dos saltos? ")
      Leia (Salto)
      Enquanto (Cont <= Valor)faca
               Escreval(Cont)
               Cont <- Cont + salto
      FimEnquanto
      Escreval ("Terminei de contar")
fimalgoritmo